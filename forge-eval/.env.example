# forge-eval 本地开发用 — 实际 .env 不进 git(.gitignore 已排除)
#
# 认证(API_KEY 或 AUTH_TOKEN 二选一,至少配一个):
#
# 方式 A:Anthropic 原生(x-api-key header)— 从 https://console.anthropic.com/ 取 key
ANTHROPIC_API_KEY=sk-ant-xxx
#
# 方式 B:Bearer token(Authorization: Bearer header)— 部分第三方使用
# (例:PackyAPI / LiteLLM Bearer 模式 / Claude Code 风格的转发服务)
# ANTHROPIC_AUTH_TOKEN=sk-xxx

# 可选:第三方兼容 endpoint(OpenRouter / LiteLLM / Bedrock proxy / PackyAPI 等),
# 未配置或空值时走官方默认 https://api.anthropic.com
# ANTHROPIC_BASE_URL=https://www.packyapi.com
